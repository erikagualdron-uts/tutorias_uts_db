generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  TEACHER
  STUDENT

  @@map("role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum Locale {
  es
  en

  @@map("locale")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_purpose")
}

// email is stored already normalized (lowercase, trimmed); a soft-deleted user keeps the email taken.
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String     @map("password_hash")
  role               Role
  status             UserStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  locale             Locale     @default(es)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  sessions        Session[]
  codes           VerificationCode[]
  taughtModules   Module[]
  enrollments     Enrollment[]
  notifications   Notification[]
  pushTokens      PushToken[]
  pqrs            Pqrs[]
  pqrsMessages    PqrsMessage[]
  chatMemberships ConversationMember[]
  chatMessages    Message[]
  nameChanges     StudentNameChange[]

  @@map("users")
}

model StudentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  program   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("student_profiles")
}

model TeacherProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("teacher_profiles")
}

// One row per device. Only the hash of the opaque refresh token is stored.
model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  // Hash of the token just rotated out; presenting it again means the token was stolen or replayed.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  deviceLabel              String?   @map("device_label")
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id])
  pushTokens PushToken[]

  @@index([userId])
  @@map("sessions")
}

model VerificationCode {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  codeHash  String              @map("code_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  attempts  Int                 @default(0)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("verification_codes")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model SmtpConfig {
  id                String   @id @default(uuid()) @db.Uuid
  host              String
  port              Int
  user              String
  passwordEncrypted String   @map("password_encrypted")
  from              String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("smtp_configs")
}

enum PeriodStatus {
  UPCOMING
  ACTIVE
  CLOSED

  @@map("period_status")
}

enum PeriodClosedBy {
  MANUAL
  AUTOMATIC

  @@map("period_closed_by")
}

enum RoomStatus {
  ACTIVE
  INACTIVE

  @@map("room_status")
}

enum ItemStatus {
  ACTIVE
  INACTIVE

  @@map("item_status")
}

// startsOn/endsOn are calendar days in America/Bogota. The partial unique indexes, the exclusion
// constraint and the CHECKs live only in the migration SQL (Prisma cannot model them).
model AcademicPeriod {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(50)
  startsOn  DateTime        @map("starts_on") @db.Date
  endsOn    DateTime        @map("ends_on") @db.Date
  status    PeriodStatus    @default(UPCOMING)
  closedAt  DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedBy  PeriodClosedBy? @map("closed_by")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)

  modules Module[]

  @@map("academic_periods")
}

model Location {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(80)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rooms Room[]

  @@map("locations")
}

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  locationId String     @map("location_id") @db.Uuid
  name       String     @db.VarChar(40)
  capacity   Int
  status     RoomStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  location Location @relation(fields: [locationId], references: [id])
  modules  Module[]

  @@index([locationId])
  @@map("rooms")
}

// Lists are created by migrations only; the API manages their items.
model DropdownList {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  nameEs    String   @map("name_es")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items DropdownItem[]

  @@map("dropdown_lists")
}

model DropdownItem {
  id        String     @id @default(uuid()) @db.Uuid
  listId    String     @map("list_id") @db.Uuid
  labelEs   String     @map("label_es") @db.VarChar(80)
  labelEn   String     @map("label_en") @db.VarChar(80)
  sortOrder Int        @map("sort_order")
  status    ItemStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  list DropdownList @relation(fields: [listId], references: [id])
  pqrs Pqrs[]

  @@index([listId, sortOrder])
  @@map("dropdown_items")
}

enum SessionStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED

  @@map("session_status")
}

enum SessionCancelReason {
  HOLIDAY
  TEACHER

  @@map("session_cancel_reason")
}

enum HolidaySource {
  MANUAL
  IMPORTED

  @@map("holiday_source")
}

enum OutboxEventType {
  MODULE_TEACHER_CHANGED
  MODULE_ROOM_CHANGED
  SESSIONS_CANCELLED_HOLIDAY
  SESSIONS_RESTORED_HOLIDAY
  SESSION_RESCHEDULED
  SESSION_CANCELLED_TEACHER
  SESSION_RESTORED_TEACHER
  PQRS_IN_REVIEW
  PQRS_RESPONDED
  PQRS_RESOLVED

  @@map("outbox_event_type")
}

// A tutoring module of one academic period (spec 010). The capacity (cupo) is never stored: it is
// the capacity of `room`. The module has no status of its own: it is live while deletedAt is null.
model Module {
  id          String    @id @default(uuid()) @db.Uuid
  periodId    String    @map("period_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(1000)
  teacherId   String    @map("teacher_id") @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  period        AcademicPeriod   @relation(fields: [periodId], references: [id])
  teacher       User             @relation(fields: [teacherId], references: [id])
  room          Room             @relation(fields: [roomId], references: [id])
  schedules     ModuleSchedule[]
  sessions      ModuleSession[]
  events        OutboxEvent[]
  enrollments   Enrollment[]
  notifications Notification[]
  conversation  Conversation?

  @@index([periodId])
  @@index([teacherId])
  @@index([roomId])
  @@map("modules")
}

// Weekly slot in local America/Bogota time. periodId, teacherId and roomId are copies of the
// module's values so the exclusion constraints (migration SQL) can see them; the service keeps
// them in sync in the same transaction that changes the module.
model ModuleSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  periodId    String    @map("period_id") @db.Uuid
  teacherId   String    @map("teacher_id") @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  dayOfWeek   Int       @map("day_of_week") @db.SmallInt
  startMinute Int       @map("start_minute") @db.SmallInt
  endMinute   Int       @map("end_minute") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  module   Module          @relation(fields: [moduleId], references: [id])
  sessions ModuleSession[]

  @@index([moduleId])
  @@map("module_schedules")
}

// One weekly occurrence of a module. teacherId and roomId are the ones that give this session;
// changing them on the module only updates sessions that start in the future.
model ModuleSession {
  id               String               @id @default(uuid()) @db.Uuid
  moduleId         String               @map("module_id") @db.Uuid
  scheduleId       String               @map("schedule_id") @db.Uuid
  teacherId        String               @map("teacher_id") @db.Uuid
  roomId           String               @map("room_id") @db.Uuid
  originalStartsAt DateTime             @map("original_starts_at") @db.Timestamptz(6)
  startsAt         DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime             @map("ends_at") @db.Timestamptz(6)
  status           SessionStatus        @default(SCHEDULED)
  cancelReason     SessionCancelReason? @map("cancel_reason")
  holidayId        String?              @map("holiday_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)

  module   Module           @relation(fields: [moduleId], references: [id])
  schedule ModuleSchedule   @relation(fields: [scheduleId], references: [id])
  holiday  Holiday?         @relation(fields: [holidayId], references: [id])
  absences SessionAbsence[]

  @@index([moduleId, startsAt])
  @@index([startsAt])
  @@index([roomId, startsAt])
  @@index([teacherId, startsAt])
  @@map("module_sessions")
}

// A calendar day (America/Bogota) with no tutoring. Global: it applies to every period.
model Holiday {
  id        String        @id @default(uuid()) @db.Uuid
  date      DateTime      @db.Date
  name      String        @db.VarChar(120)
  source    HolidaySource @default(MANUAL)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)

  sessions ModuleSession[]

  @@map("holidays")
}

// Events the notifications feature (spec 013) sends later. Written in the same transaction as the
// change; a log, so it has no updatedAt or deletedAt.
model OutboxEvent {
  id          String          @id @default(uuid()) @db.Uuid
  type        OutboxEventType
  moduleId    String?         @map("module_id") @db.Uuid
  pqrsId      String?         @map("pqrs_id") @db.Uuid
  payload     Json
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(6)

  module        Module?        @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  pqrs          Pqrs?          @relation(fields: [pqrsId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

enum NotificationChannel {
  PUSH
  EMAIL

  @@map("notification_channel")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@map("delivery_status")
}

enum DevicePlatform {
  ANDROID
  IOS

  @@map("device_platform")
}

// A notice for one user, already written in their language (spec 014). One per event and user
// (unique index), so replaying an event never duplicates it. A log: no deletedAt, nothing removes it.
// The partial index on unread notices is in the migration SQL.
model Notification {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  type      OutboxEventType
  moduleId  String?         @map("module_id") @db.Uuid
  pqrsId    String?         @map("pqrs_id") @db.Uuid
  locale    Locale
  title     String          @db.VarChar(160)
  body      String          @db.VarChar(1000)
  readAt    DateTime?       @map("read_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                   @relation(fields: [userId], references: [id])
  event      OutboxEvent            @relation(fields: [eventId], references: [id])
  module     Module?                @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  pqrs       Pqrs?                  @relation(fields: [pqrsId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([eventId, userId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

// State of one notice in one channel; its id is also the BullMQ job id. lastError holds only a
// stable cause code, never free text or personal data.
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error") @db.VarChar(60)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, channel])
  @@index([status, updatedAt])
  @@map("notification_deliveries")
}

// A device allowed to receive push (spec 014). The token is unique in the whole table: a device
// belongs to one user. Closing the session or an invalid token sets deletedAt.
model PushToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  token     String         @unique @db.VarChar(200)
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@map("push_tokens")
}

// Write-once record of each student name change (spec 033): never edited, never deleted.
model StudentNameChange {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  previousFirstName String   @map("previous_first_name")
  previousLastName  String   @map("previous_last_name")
  newFirstName      String   @map("new_first_name")
  newLastName       String   @map("new_last_name")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("student_name_changes")
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

// A student's enrollment in a module (spec 011). One ACTIVE per student and module (partial unique
// index and CHECK in the migration SQL). effectiveUntil keeps sessions starting before it.
model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  moduleId       String           @map("module_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  effectiveUntil DateTime?        @map("effective_until") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  student  User             @relation(fields: [studentId], references: [id])
  module   Module           @relation(fields: [moduleId], references: [id])
  absences SessionAbsence[]

  @@index([moduleId, status])
  @@index([studentId, status])
  @@map("enrollments")
}

// The student stays enrolled but skips one session; deletedAt marks that it was restored.
model SessionAbsence {
  id           String    @id @default(uuid()) @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id])
  session    ModuleSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("session_absences")
}

enum PqrsStatus {
  FILED
  IN_REVIEW
  RESOLVED

  @@map("pqrs_status")
}

// A request, complaint, claim or suggestion filed by a teacher or a student (spec 017). Only the CAE
// moves it forward: FILED -> IN_REVIEW -> RESOLVED, and it needs one reply to be resolved.
// `clientRequestId` makes a retried filing return the same row instead of creating another.
model Pqrs {
  id              String     @id @default(uuid()) @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  typeId          String     @map("type_id") @db.Uuid
  subject         String     @db.VarChar(200)
  description     String     @db.VarChar(4000)
  status          PqrsStatus @default(FILED)
  clientRequestId String     @map("client_request_id") @db.Uuid
  reviewedAt      DateTime?  @map("reviewed_at") @db.Timestamptz(6)
  resolvedAt      DateTime?  @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  author        User           @relation(fields: [authorId], references: [id])
  type          DropdownItem   @relation(fields: [typeId], references: [id])
  messages      PqrsMessage[]
  events        OutboxEvent[]
  notifications Notification[]

  @@unique([authorId, clientRequestId])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([typeId])
  @@map("pqrs")
}

// A reply of the CAE inside a PQRS.
model PqrsMessage {
  id        String    @id @default(uuid()) @db.Uuid
  pqrsId    String    @map("pqrs_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String    @db.VarChar(4000)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  pqrs   Pqrs @relation(fields: [pqrsId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([pqrsId, createdAt])
  @@map("pqrs_messages")
}

enum ConversationType {
  DIRECT
  MODULE

  @@map("conversation_type")
}

enum MessageKind {
  TEXT
  ANNOUNCEMENT

  @@map("message_kind")
}

// A chat: between two people (DIRECT, one per pair) or of a module (MODULE, one per module, created on
// demand). Who may see and write is derived from enrollments, never copied (spec 018).
model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  type          ConversationType
  moduleId      String?          @unique @map("module_id") @db.Uuid
  directKey     String?          @unique @map("direct_key") @db.VarChar(73)
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)

  module   Module?              @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

// Where each person stopped reading; the unread count comes from lastReadAt.
model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

// clientMessageId makes a retried send return the same row instead of creating another.
model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  kind            MessageKind @default(TEXT)
  body            String      @db.VarChar(4000)
  clientMessageId String      @map("client_message_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}
